# Copy this file to .env and adjust as needed:   cp .env.example .env
# Real environment variables override values in .env.

# --- Identity ---
NOVA_NAME=NOVA
NOVA_VERSION=0.1

# --- Brain ---
# ollama = local model through Ollama (https://ollama.com)
# mock   = simple built-in test brain, no AI model needed
NOVA_BRAIN=ollama

# --- Ollama (local model) ---
OLLAMA_HOST=http://localhost:11434
# The model you pulled, e.g. llama3.2  (run: ollama pull llama3.2)
OLLAMA_MODEL=
# Seconds to wait for a reply (local models can be slow on first load)
OLLAMA_TIMEOUT=120

# --- Storage & logging ---
# Relative paths are relative to the project folder.
NOVA_DATA_DIR=data
NOVA_PERSONALITY_FILE=personality/nova.txt
# DEBUG, INFO, WARNING, ERROR or CRITICAL
NOVA_LOG_LEVEL=INFO

# --- Context ---
# How many recent messages NOVA keeps in the current conversation
NOVA_MAX_HISTORY=20
# How many saved memories are included in each prompt
NOVA_MAX_MEMORIES_IN_PROMPT=50
