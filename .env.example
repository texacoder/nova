# Copy this file to .env and adjust as needed:
#   Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env
# Real environment variables override values in .env.

# --- Identity ---
NOVA_NAME=NOVA
NOVA_VERSION=1.0

# --- Brain (a free AI model running on this PC through Ollama) ---
NOVA_BRAIN=ollama
OLLAMA_HOST=http://localhost:11434
# Leave empty: NOVA's automatic setup picks the best model for your PC and fills this in.
# Or set one yourself, e.g. qwen2.5:7b (16 GB RAM), qwen2.5:3b (8 GB), llama3.1:8b
OLLAMA_MODEL=
# Seconds to wait for a reply (the first reply after starting can be slow)
OLLAMA_TIMEOUT=300
# How much text the model can consider at once. Lower it (e.g. 4096) if replies are slow.
OLLAMA_NUM_CTX=8192

# --- PC control ---
# NOVA's own folder. It can create/read files here without asking.
NOVA_WORKSPACE=~/NOVA_Workspace
# Your app shortcuts (copy apps.example.json to apps.json)
NOVA_APPS_FILE=apps.json
# Max seconds a command may run
NOVA_COMMAND_TIMEOUT=60
# Tools that never ask for approval, comma-separated (be careful!), e.g. write_file,open_path
NOVA_AUTO_APPROVE=

# --- Email (optional; for Gmail use an App Password, see README) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com

# --- Web interface ---
NOVA_WEB_HOST=127.0.0.1
NOVA_WEB_PORT=8765

# --- Storage & logging ---
# Relative paths are relative to the project folder.
NOVA_DATA_DIR=data
NOVA_PERSONALITY_FILE=personality/nova.txt
# DEBUG, INFO, WARNING, ERROR or CRITICAL
NOVA_LOG_LEVEL=INFO

# --- Context ---
# Recent messages kept in the conversation (tool results count too)
NOVA_MAX_HISTORY=40
# Saved memories included in each prompt
NOVA_MAX_MEMORIES_IN_PROMPT=50
# Max tool actions NOVA may chain for one request
NOVA_MAX_TOOL_STEPS=8
